# Cinch environment configuration — copy to `.env` for local development.
# NEVER commit a real .env file or real secrets. All values below are placeholders.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO
LOG_JSON=true
# PORT=8000                  # ASGI bind port; PaaS platforms (Render/Heroku) set this for you

# --- Database ----------------------------------------------------------------
# Local dev (SQLite / aiosqlite):
DATABASE_URL=sqlite+aiosqlite:///./cinch.db
# Production (PostgreSQL / asyncpg):
# DATABASE_URL=postgresql+asyncpg://cinch:cinch@localhost:5432/cinch

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# Public HTTPS base URL; when set, the webhook is registered on startup.
# TELEGRAM_WEBHOOK_URL=https://your-app.example.com

# --- LLM providers (choose one; provider-agnostic layer) ---------------------
LLM_PROVIDER=anthropic       # anthropic | groq | openai | google
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# FREE option — Groq (OpenAI-compatible, no card). Set LLM_PROVIDER=groq, then:
#   GROQ_API_KEY=gsk_xxxxxxxx
#   LLM_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=sk-xxxxxxxx
# GOOGLE_API_KEY=xxxxxxxx
LLM_MODEL=claude-opus-4-8    # model id for the active provider
LLM_MAX_TOKENS=4096
GROUNDING_USE_LLM_JUDGE=false # optional semantic grounding judge (2nd layer)

# --- Job sources -------------------------------------------------------------
# Comma-separated list of adapters to enable (Phase 7). Free sources need no
# signup; Adzuna needs the ADZUNA_APP_ID/KEY below. Missing-cred sources are
# skipped with a log warning, so partial config still works.
#   Common configs:
#     JOB_SOURCES=adzuna,remoteok,arbeitnow    # everything (recommended)
#     JOB_SOURCES=remoteok,arbeitnow           # 100% free, no signup at all
#     JOB_SOURCES=adzuna                       # legacy default
JOB_SOURCES=adzuna
# Adzuna is an official/licensed API — register at developer.adzuna.com for creds.
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=us            # country-scoped: us | gb | in | ...
# ADZUNA_WHERE=Remote        # optional global location filter

# --- Discovery / scheduler ---------------------------------------------------
DISCOVERY_ENABLED=false      # scheduler is off unless explicitly enabled
DISCOVERY_INTERVAL_MINUTES=60
DISCOVERY_RESULTS_PER_USER=5

# --- Assisted submission (Phase 6, EXPERIMENTAL) -----------------------------
# ⚠️ Auto-submitting applications may VIOLATE job-site Terms of Service and risk
# your accounts. OFF by default; only enable with explicit sign-off. Never bypasses
# CAPTCHAs/logins (those hand back to you). Requires: pip extra `submit` +
# `playwright install chromium`. Only user-approved applications are submitted.
SUBMISSION_ENABLED=false
SUBMISSION_INTERVAL_MINUTES=5
SUBMISSION_HEADLESS=true
SUBMISSION_TIMEOUT_SECONDS=60

# --- Email webhook (Phase 11) -----------------------------------------------
# Shared secret for POST /webhook/email — must match the X-Cinch-Webhook-Secret
# header your Zapier / Make automation sends. When unset the webhook returns 503.
# INTERVIEW_WEBHOOK_SECRET=generate-a-long-random-string

# --- Security ----------------------------------------------------------------
# Fernet key encrypting resume PII at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When unset, resume content is stored plaintext (a startup warning is logged).
# ENCRYPTION_KEY=

# --- Observability -----------------------------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.0
