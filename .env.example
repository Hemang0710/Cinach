# Cinch environment configuration — copy to `.env` for local development.
# NEVER commit a real .env file or real secrets. All values below are placeholders.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database ----------------------------------------------------------------
# Local dev (SQLite / aiosqlite):
DATABASE_URL=sqlite+aiosqlite:///./cinch.db
# Production (PostgreSQL / asyncpg):
# DATABASE_URL=postgresql+asyncpg://cinch:cinch@localhost:5432/cinch

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# Public HTTPS base URL; when set, the webhook is registered on startup.
# TELEGRAM_WEBHOOK_URL=https://your-app.example.com

# --- LLM providers (choose one; provider-agnostic layer) ---------------------
LLM_PROVIDER=anthropic       # anthropic | openai | google
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx
# GOOGLE_API_KEY=xxxxxxxx
LLM_MODEL=claude-opus-4-8    # model id for the active provider
LLM_MAX_TOKENS=4096
GROUNDING_USE_LLM_JUDGE=false # optional semantic grounding judge (2nd layer)

# --- Job sources -------------------------------------------------------------
# Adzuna is an official/licensed API — register at developer.adzuna.com for creds.
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=us            # country-scoped: us | gb | in | ...
# ADZUNA_WHERE=Remote        # optional global location filter

# --- Discovery / scheduler ---------------------------------------------------
DISCOVERY_ENABLED=false      # scheduler is off unless explicitly enabled
DISCOVERY_INTERVAL_MINUTES=60
DISCOVERY_RESULTS_PER_USER=5

# --- Observability -----------------------------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
